# Local values come from `pnpm supabase status` after `pnpm db:start`.
# Never put the secret key into a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only.
SUPABASE_SECRET_KEY=

# Direct Postgres connection for integration tests (local Supabase default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
