# Local values come from `pnpm supabase status` after `pnpm db:start`.
# All three are server-only: there is no browser Supabase client, so nothing goes into NEXT_PUBLIC_*.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# service_role: sign-in throttling (and staff management later). Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Direct Postgres connection for integration tests (local Supabase default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
